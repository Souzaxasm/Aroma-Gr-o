<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Aroma &amp; Grão — Cafeteria de especialidade</title>
<meta name="description" content="Aroma & Grão: cafés especiais, origem rastreável e guia de preparo.">
<link rel="stylesheet" href="css/style.css">
</head>
<body>
<a class="skip" href="#conteudo">Pular para o conteúdo</a>

<header class="top">
  <div class="container bar">
    <a class="logo" href="#inicio" aria-label="Aroma e Grão, início">☕ Aroma &amp; Grão</a>
    <nav aria-label="Navegação principal">
      <ul>
        <li><a href="#cardapio">Cardápio</a></li>
        <li><a href="#explorar">Explorar</a></li>
        <li><a href="#galeria">Galeria</a></li>
        <li><a href="#preparo">Preparo</a></li>
        <li><a href="#contato">Contato</a></li>
        <li><a href="login.html">Entrar</a></li>
      </ul>
    </nav>
    <div class="tools">
      <button class="icon-btn" id="theme-btn" aria-pressed="false" aria-label="Alternar modo escuro">🌙</button>
      <button class="icon-btn" id="a11y-btn" aria-expanded="false" aria-controls="a11y-panel" aria-label="Abrir painel de acessibilidade">♿</button>
    </div>
  </div>
  <div class="a11y-panel" id="a11y-panel" role="dialog" aria-label="Painel de acessibilidade" hidden>
    <h2>Acessibilidade</h2>
    <div class="row">
      <button class="btn ghost" id="font-minus" aria-label="Diminuir fonte">A−</button>
      <button class="btn ghost" id="font-plus" aria-label="Aumentar fonte">A+</button>
    </div>
    <div class="row">
      <button class="btn ghost" id="theme-btn2" aria-pressed="false">Modo escuro</button>
    </div>
    <div class="row">
      <button class="btn ghost" id="contrast-btn" aria-pressed="false">Alto contraste</button>
    </div>
    <div class="row">
      <button class="btn" id="reset-btn">Restaurar padrão</button>
    </div>
    <p class="help" id="font-status" aria-live="polite">Tamanho da fonte: 100%</p>
  </div>
</header>

<main id="conteudo">
  <!-- HERO -->
  <section class="hero" id="inicio">
    <div class="container grid">
      <div>
        <span class="eyebrow">Cafeteria de especialidade · Brasília</span>
        <h1>Cada xícara conta a história de um grão.</h1>
        <p>Cafés de pequenos produtores, torra artesanal e um guia para você preparar em casa o melhor café da sua vida.</p>
        <p><a class="btn" href="#cardapio">Ver cardápio</a> <a class="btn ghost" href="#preparo">Aprender a preparar</a></p>
      </div>
      <svg viewBox="0 0 400 300" role="img" aria-label="Ilustração de uma xícara de café fumegante sobre um pires">
        <rect width="400" height="300" rx="16" fill="#F3E6D6"/>
        <ellipse cx="200" cy="232" rx="130" ry="26" fill="#D8C3AA"/>
        <path d="M110 120h180v60a90 70 0 0 1-180 0z" fill="#6F4E37"/>
        <path d="M290 135h26a28 28 0 0 1 0 56h-30" fill="none" stroke="#6F4E37" stroke-width="14"/>
        <ellipse cx="200" cy="120" rx="90" ry="18" fill="#2B1B12"/>
        <path d="M165 90c-14-20 14-30 0-50M200 90c-14-20 14-30 0-50M235 90c-14-20 14-30 0-50" fill="none" stroke="#8C6A52" stroke-width="6" stroke-linecap="round"/>
      </svg>
    </div>
  </section>

  <!-- CARTÕES: CARDÁPIO -->
  <section id="cardapio">
    <div class="container">
      <h2>Cardápio da casa</h2>
      <div class="cards">
        <article class="card">
          <svg viewBox="0 0 200 120" role="img" aria-label="Ilustração de uma xícara de espresso"><rect width="200" height="120" fill="none"/><ellipse cx="100" cy="95" rx="60" ry="10" fill="#D8C3AA"/><path d="M65 50h70v22a35 28 0 0 1-70 0z" fill="#6F4E37"/><path d="M135 56h10a11 11 0 0 1 0 22h-12" fill="none" stroke="#6F4E37" stroke-width="6"/><ellipse cx="100" cy="50" rx="35" ry="7" fill="#2B1B12"/></svg>
          <span class="tag">Clássico</span>
          <h3>Espresso</h3>
          <p>Notas de chocolate e caramelo, corpo intenso.</p>
          <p class="price">R$ 7,00</p>
        </article>
        <article class="card">
          <svg viewBox="0 0 200 120" role="img" aria-label="Ilustração de um cappuccino com espuma"><ellipse cx="100" cy="95" rx="62" ry="10" fill="#D8C3AA"/><path d="M55 45h90v28a45 32 0 0 1-90 0z" fill="#2F5D50"/><ellipse cx="100" cy="45" rx="45" ry="9" fill="#F3E6D6"/><path d="M85 45c10-8 20-8 30 0-10 5-20 5-30 0z" fill="#C79A6B"/></svg>
          <span class="tag">Mais pedido</span>
          <h3>Cappuccino</h3>
          <p>Espresso, leite vaporizado e espuma cremosa.</p>
          <p class="price">R$ 12,00</p>
        </article>
        <article class="card">
          <svg viewBox="0 0 200 120" role="img" aria-label="Ilustração de uma jarra de café coado"><rect x="60" y="25" width="80" height="70" rx="10" fill="#8C6A52"/><rect x="60" y="55" width="80" height="40" rx="8" fill="#2B1B12"/><path d="M140 40h14a14 14 0 0 1 0 36h-14" fill="none" stroke="#6F4E37" stroke-width="7"/><rect x="55" y="95" width="90" height="8" rx="3" fill="#D8C3AA"/></svg>
          <span class="tag">Método</span>
          <h3>Café coado V60</h3>
          <p>Notas florais e cítricas, acidez brilhante.</p>
          <p class="price">R$ 14,00</p>
        </article>
        <article class="card">
          <svg viewBox="0 0 200 120" role="img" aria-label="Ilustração de um copo de café gelado com gelo"><path d="M70 25h60l-8 78H78z" fill="#6F4E37"/><rect x="82" y="38" width="22" height="22" rx="4" fill="#F3E6D6" opacity=".75"/><rect x="104" y="55" width="20" height="20" rx="4" fill="#F3E6D6" opacity=".75"/><path d="M110 25l24-18" stroke="#2F5D50" stroke-width="6" stroke-linecap="round"/></svg>
          <span class="tag">Refrescante</span>
          <h3>Cold brew</h3>
          <p>Extração a frio por 18 horas, doce e suave.</p>
          <p class="price">R$ 15,00</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ABAS + PESQUISA -->
  <section id="explorar" style="background:var(--card)">
    <div class="container">
      <h2>Explore o mundo do café</h2>
      <div class="search" role="search">
        <div style="flex:1;min-width:220px">
          <label for="busca">Pesquisar nos conteúdos</label>
          <input type="search" id="busca" placeholder="Ex.: origem, torra, sustentável, moagem" autocomplete="off">
        </div>
      </div>
      <p class="help" id="busca-status" aria-live="polite"></p>

      <div role="tablist" aria-label="Seções de conteúdo">
        <button role="tab" id="tab-origem" aria-selected="true" aria-controls="painel-origem" tabindex="0">Origem</button>
        <button role="tab" id="tab-torra" aria-selected="false" aria-controls="painel-torra" tabindex="-1">Torra</button>
        <button role="tab" id="tab-sustentavel" aria-selected="false" aria-controls="painel-sustentavel" tabindex="-1">Sustentabilidade</button>
      </div>

      <div role="tabpanel" id="painel-origem" aria-labelledby="tab-origem">
        <div class="cards">
          <article class="card searchable"><h3>Cerrado Mineiro</h3><p>Região de clima seco e altitude, produz cafés doces, com notas de chocolate e nozes. Primeira região brasileira com denominação de origem.</p></article>
          <article class="card searchable"><h3>Sul de Minas</h3><p>Montanhas e microclimas que favorecem cafés de corpo médio, acidez equilibrada e notas de caramelo.</p></article>
          <article class="card searchable"><h3>Matas de Minas</h3><p>Cultivo em encostas com sombreamento natural, com cafés frutados e aromáticos de origem rastreável.</p></article>
        </div>
      </div>
      <div role="tabpanel" id="painel-torra" aria-labelledby="tab-torra" class="hidden">
        <div class="cards">
          <article class="card searchable"><h3>Torra clara</h3><p>Preserva a acidez e as notas florais e cítricas do grão. Ideal para métodos filtrados.</p></article>
          <article class="card searchable"><h3>Torra média</h3><p>Equilíbrio entre doçura, acidez e corpo. A mais versátil para o dia a dia.</p></article>
          <article class="card searchable"><h3>Torra escura</h3><p>Sabor intenso, amargor marcante e notas de cacau amargo. Muito usada em espresso.</p></article>
        </div>
      </div>
      <div role="tabpanel" id="painel-sustentavel" aria-labelledby="tab-sustentavel" class="hidden">
        <div class="cards">
          <article class="card searchable"><h3>Borra de café</h3><p>Reaproveitada como adubo orgânico nos canteiros dos nossos produtores parceiros.</p></article>
          <article class="card searchable"><h3>Comércio justo</h3><p>Pagamos acima do preço de mercado e informamos a origem de cada lote.</p></article>
          <article class="card searchable"><h3>Embalagem sustentável</h3><p>Sacos compostáveis e copos retornáveis com desconto para quem traz o seu.</p></article>
        </div>
      </div>
      <p class="empty hidden" id="sem-resultado">Nenhum conteúdo encontrado para a sua pesquisa.</p>
    </div>
  </section>

  <!-- CARROSSEL -->
  <section id="galeria">
    <div class="container">
      <h2>Galeria</h2>
      <div class="carousel" role="region" aria-roledescription="carrossel" aria-label="Galeria de imagens da cafeteria">
        <div class="slides" id="slides" aria-live="off">
          <figure class="slide" style="margin:0" aria-roledescription="slide" aria-label="1 de 3">
            <svg viewBox="0 0 900 380" role="img" aria-label="Ilustração de grãos de café sobre fundo marrom"><rect width="900" height="380" fill="#6F4E37"/><g fill="#2B1B12"><ellipse cx="160" cy="120" rx="48" ry="32" transform="rotate(-25 160 120)"/><ellipse cx="330" cy="230" rx="52" ry="34" transform="rotate(20 330 230)"/><ellipse cx="520" cy="110" rx="46" ry="30" transform="rotate(35 520 110)"/><ellipse cx="700" cy="220" rx="54" ry="35" transform="rotate(-15 700 220)"/><ellipse cx="800" cy="90" rx="40" ry="27" transform="rotate(10 800 90)"/></g><g stroke="#8C6A52" stroke-width="4" fill="none" stroke-linecap="round"><path d="M125 135q35-30 70-30"/><path d="M295 245q35-25 70-10"/><path d="M490 120q30-20 60 0"/><path d="M660 235q40-25 80 0"/></g></svg>
            <figcaption class="caption"><strong>Grãos selecionados</strong><br>Colhidos à mão e torrados em pequenos lotes.</figcaption>
          </figure>
          <figure class="slide" style="margin:0" aria-roledescription="slide" aria-label="2 de 3">
            <svg viewBox="0 0 900 380" role="img" aria-label="Ilustração de uma prensa francesa com café"><rect width="900" height="380" fill="#2F5D50"/><rect x="380" y="90" width="140" height="210" rx="10" fill="#F3E6D6" opacity=".9"/><rect x="380" y="170" width="140" height="130" rx="8" fill="#2B1B12"/><rect x="370" y="80" width="160" height="16" rx="6" fill="#1A1210"/><rect x="443" y="40" width="14" height="46" fill="#1A1210"/><circle cx="450" cy="36" r="14" fill="#1A1210"/><path d="M520 130h30a28 28 0 0 1 0 70h-30" fill="none" stroke="#1A1210" stroke-width="12"/><rect x="360" y="300" width="180" height="14" rx="5" fill="#1A1210"/></svg>
            <figcaption class="caption"><strong>Prensa francesa</strong><br>Quatro minutos de infusão para um café encorpado.</figcaption>
          </figure>
          <figure class="slide" style="margin:0" aria-roledescription="slide" aria-label="3 de 3">
            <svg viewBox="0 0 900 380" role="img" aria-label="Ilustração de um moedor de café manual"><rect width="900" height="380" fill="#B5651D"/><rect x="390" y="120" width="120" height="170" rx="12" fill="#2B1B12"/><path d="M400 120l-30-60h160l-30 60z" fill="#6F4E37"/><rect x="350" y="52" width="200" height="14" rx="6" fill="#1A1210"/><rect x="540" y="40" width="70" height="12" rx="6" fill="#1A1210"/><circle cx="615" cy="46" r="14" fill="#1A1210"/><rect x="410" y="290" width="80" height="30" fill="#F3E6D6"/></svg>
            <figcaption class="caption"><strong>Moagem na hora</strong><br>Aroma preservado do grão à xícara.</figcaption>
          </figure>
        </div>
        <button class="nav-btn prev" id="prev" aria-label="Slide anterior">‹</button>
        <button class="nav-btn next" id="next" aria-label="Próximo slide">›</button>
        <div class="dots" id="dots" role="group" aria-label="Escolher slide"></div>
      </div>
      <p><button class="btn ghost" id="play" aria-pressed="false">⏸ Pausar rotação</button></p>
    </div>
  </section>

  <!-- CARTÕES EXPLICATIVOS -->
  <section id="preparo" style="background:var(--card)">
    <div class="container">
      <h2>Como preparar em casa</h2>
      <div class="cards">
        <article class="card step"><span class="num" aria-hidden="true">1</span><div><h3>Escolha o grão</h3><p>Prefira lotes recém-torrados, com data de torra na embalagem.</p></div></article>
        <article class="card step"><span class="num" aria-hidden="true">2</span><div><h3>Moa na hora</h3><p>Moagem média para coado; grossa para prensa francesa.</p></div></article>
        <article class="card step"><span class="num" aria-hidden="true">3</span><div><h3>Água a 92–96 °C</h3><p>Água fervendo queima o café; deixe esfriar um minuto.</p></div></article>
        <article class="card step"><span class="num" aria-hidden="true">4</span><div><h3>Proporção</h3><p>Comece com 1 g de café para cada 15 ml de água e ajuste ao seu gosto.</p></div></article>
      </div>
    </div>
  </section>

  <!-- CONTATO -->
  <section id="contato">
    <div class="container">
      <h2>Fale com a gente</h2>
      <form id="form-contato" novalidate>
        <div><label for="nome">Nome</label><input id="nome" name="nome" autocomplete="name" required aria-describedby="e-nome"><p class="err" id="e-nome"></p></div>
        <div><label for="email">E-mail</label><input id="email" name="email" type="email" autocomplete="email" required aria-describedby="e-email"><p class="err" id="e-email"></p></div>
        <div><label for="assunto">Assunto</label>
          <select id="assunto" name="assunto"><option>Dúvida</option><option>Elogio</option><option>Reserva de mesa</option><option>Parcerias</option></select></div>
        <div><label for="msg">Mensagem</label><textarea id="msg" name="msg" rows="5" required aria-describedby="e-msg"></textarea><p class="err" id="e-msg"></p></div>
        <div><button class="btn" type="submit">Enviar mensagem</button></div>
        <p class="ok" id="ok-contato" role="status"></p>
      </form>
    </div>
  </section>
</main>

<footer>
  <div class="container">
    <div class="cols">
      <div><h2>Aroma &amp; Grão</h2><p>Café de especialidade com origem rastreável e preparo consciente.</p></div>
      <div><h2>Horários</h2><ul><li>Seg a Sex: 7h às 20h</li><li>Sáb e Dom: 8h às 18h</li></ul></div>
      <div><h2>Links</h2><ul><li><a href="#cardapio">Cardápio</a></li><li><a href="#contato">Contato</a></li><li><a href="login.html">Área do cliente</a></li></ul></div>
    </div>
    <p class="copy">© 2026 Aroma &amp; Grão · Projeto acadêmico de Desenvolvimento de Interfaces · CEUB</p>
  </div>
</footer>
<script src="js/main.js"></script>
</body>
</html>
